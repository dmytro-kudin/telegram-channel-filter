# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env` — it is in .gitignore.
#
# For production deployments, set these values as GitHub repository secrets:
# - API_ID
# - API_HASH
# - BOT_TOKEN
# - ADMIN_CHAT_ID
# - SOURCE_CHANNEL (optional, defaults shown below)
#
# The deploy.yml workflow will inject these secrets into the deployed .env file.

# Telethon (userbot) API credentials for the account that JOINS and reads the
# source channel. Get these at https://my.telegram.org (API development tools).
API_ID=
API_HASH=

# Bot token for the subscriber-facing bot, from @BotFather on Telegram.
BOT_TOKEN=

# Public @username of the single channel this deployment monitors.
SOURCE_CHANNEL=@your_channel_username

# Telegram chat ID of the one operator account allowed to run admin commands
# (/block, /unblock, /broadcast, /stats). Message @userinfobot or similar to
# find your own chat ID.
ADMIN_CHAT_ID=

# Filesystem path to the SQLite database file (created automatically on
# first run if it doesn't exist).
DB_PATH=./channel_filter.db
